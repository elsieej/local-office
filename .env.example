# Copy thành .env.local rồi điền giá trị thật. .env.local đã có trong .gitignore.

# Khớp với docker-compose.yaml (service postgres) khi chạy DB bằng `docker compose up -d`
DATABASE_URL="postgresql://local_office:local_office@localhost:5433/local_office"

# Better Auth configuration
BETTER_AUTH_URL=http://localhost:3000
# Sinh secret: npx -y @better-auth/cli secret
BETTER_AUTH_SECRET=

# GitHub token dùng cho các thao tác issue tracker qua REST API — xem docs/agents/issue-tracker.md
GH_TOKEN=
